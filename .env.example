# ─── GMAIL CREDENTIALS (IMAP & SMTP) ──────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── GEMINI API ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── NOTION CREDENTIALS ───────────────────────────────────────────
NOTION_TOKEN=secret_your_notion_integration_token

# Notion Database IDs (specific to each newsletter domain)
NOTION_DB_WORLD_POPULATION=your_world_population_notion_db_id
NOTION_DB_CRYPTO=your_crypto_notion_db_id
NOTION_DB_MOZI=your_mozi_minute_notion_db_id
NOTION_DB_TRISTAN_BURNS=3eeb63e859c880699ee9f58eae7066d6
NOTION_DB_DAVID_COHEN=3eeb63e859c8802ca104ca8b2d73fbc7

# ─── EMAIL DIGEST SETTINGS ────────────────────────────────────────
# Recipient for the 3-bullet executive memo (defaults to GMAIL_USER if omitted)
DIGEST_RECIPIENT=your_email@gmail.com

# ─── RUNTIME PATHS ────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=INFO
