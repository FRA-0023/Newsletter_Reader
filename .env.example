# ─── GMAIL CREDENTIALS (IMAP & SMTP) ──────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── GEMINI API ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── LOCALIZATION SETTINGS ─────────────────────────────────────────
# Target language for LLM extraction and email UI chrome ('en', 'it', 'es', etc.)
# Defaults to 'en' for global open-source deployment; set to 'it' for Italian summaries
LANGUAGE=en

# ─── NOTION CREDENTIALS ───────────────────────────────────────────
NOTION_TOKEN=secret_your_notion_integration_token

# Optional dedicated Notion Database for Evening Daily Intelligence Briefings
NOTION_DB_DAILY_BRIEFING=your_daily_briefings_notion_database_id_32_chars

# Notion Database IDs per Domain (Optional environment overrides; can also be defined in config/domains.yaml)
NOTION_DB_MACRO=your_macro_notion_database_id_32_chars
NOTION_DB_CRYPTO=your_crypto_notion_database_id_32_chars
NOTION_DB_STRATEGY=your_strategy_notion_database_id_32_chars

# ─── EMAIL DIGEST SETTINGS ────────────────────────────────────────
# Recipient for the 3-bullet executive memo and daily briefing (defaults to GMAIL_USER if omitted)
DIGEST_RECIPIENT=your_email@gmail.com

# ─── RUNTIME PATHS ────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=INFO
