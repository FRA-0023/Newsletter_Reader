# ─── GMAIL CREDENTIALS (IMAP & SMTP) ──────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── GEMINI API ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── NOTION CREDENTIALS ───────────────────────────────────────────
NOTION_TOKEN=secret_your_notion_integration_token

# Notion Database IDs (Optional environment overrides; can also be defined in config/domains.yaml)
NOTION_DB_MACRO=your_macro_notion_database_id_32_chars
NOTION_DB_CRYPTO=your_crypto_notion_database_id_32_chars
NOTION_DB_STRATEGY=your_strategy_notion_database_id_32_chars

# ─── EMAIL DIGEST SETTINGS ────────────────────────────────────────
# Recipient for the 3-bullet executive memo and daily briefing (defaults to GMAIL_USER if omitted)
DIGEST_RECIPIENT=your_email@gmail.com

# ─── RUNTIME PATHS ────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=INFO
